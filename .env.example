# OpenAI
OPENAI_API_KEY=sk-...

# PostgreSQL (local Docker Compose stack)
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=ragdb

# Backend
# A hosted provider's URL can be pasted verbatim: a missing +asyncpg driver and
# libpq-only parameters such as sslmode are normalized at startup.
DATABASE_URL=postgresql+asyncpg://raguser:ragpassword@localhost:5432/ragdb
MIN_CHUNK_SIMILARITY=0.25
MAX_CHUNKS_PER_DOCUMENT=2
MAX_HISTORY_TURNS=6
HNSW_EF_SEARCH=100

# Connection pool. Lower these when several instances share one hosted pooler.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Allowed browser origins, as a JSON array. A bare hostname will not parse.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Set true in production to hide /docs, /redoc and /openapi.json.
DISABLE_OPENAPI=false

# Frontend. Read at BUILD time and inlined into the bundle, so changing it
# requires a rebuild rather than a restart.
VITE_API_BASE_URL=http://localhost:8000
